# Chép thành server/.env khi chạy local (go run ./cmd/app). Không commit .env.

APP_ENV=development            # development | production
HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=20s      # thời gian tối đa chờ request đang chạy khi tắt
HTTP_DRAIN_DELAY=0s            # production: ~5s để LB thấy /readyz 503 trước khi đóng cổng
HTTP_MAX_BODY_BYTES=2097152    # 2 MiB, khớp client_max_body_size của Nginx; 0 = không giới hạn
HTTP_TRUSTED_PROXIES=          # IP/CIDR của Nginx, cách nhau dấu phẩy (vd 172.18.0.0/16); trống = không tin proxy

LOG_LEVEL=debug                # trace | debug | info | warn | error
LOG_FORMAT=text                # json | text

POSTGRES_DSN=postgres://rag:change-me@127.0.0.1:5432/rag?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=change-me

API_DOCS_ENABLED=true          # Swagger UI tại /api/docs, spec tại /api/openapi.yaml
