# Ép LF cho mọi file văn bản để Makefile, script và code chạy được trong Git Bash
# trên Windows và không sinh diff/cảnh báo CRLF.
* text=auto

*.sh            text eol=lf
Makefile        text eol=lf
*.mk            text eol=lf
*.go            text eol=lf
*.py            text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.sql           text eol=lf
*.md            text eol=lf
.editorconfig   text eol=lf
.env.example    text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff2 binary
