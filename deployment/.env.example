# Chép thành .env rồi điền giá trị thật. Không commit .env; quyền file 600.

DATA_BIND_IP=127.0.0.1     # dev: chỉ máy local; production: IP LAN server dữ liệu, không 0.0.0.0

# ---------- Postgres ----------
POSTGRES_PASSWORD=change-me
PG_SHARED_BUFFERS=256MB    # production: ~25% RAM, vd 8GB

# ---------- Redis ----------
REDIS_PASSWORD=change-me

# ---------- Qdrant ----------
QDRANT_API_KEY=change-me

# ---------- MinIO ----------
MINIO_TAG=RELEASE.2025-04-22T22-12-26Z
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me   # tối thiểu 8 ký tự
