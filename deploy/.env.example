# CHỈ DÙNG CHO DEV. Toàn bộ giá trị dưới đây là giả, không dùng cho staging hay production.
# `make env` sao file này thành .env ở gốc repo (không ghi đè nếu .env đã có). Không commit .env.
# Đổi mật khẩu thì phải sửa luôn DATABASE_URL và REDIS_URL cho khớp, rồi `make reset`.
# Khi cần giá trị thật (secret, API key provider): dùng cơ chế riêng của module, không dán vào đây.

# --- Docker compose (deploy/docker-compose.dev.yml) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=app
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_PASSWORD=dev_only_change_me

# --- Go API (api/) ---
API_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://app:dev_only_change_me@127.0.0.1:5432/app?sslmode=disable
REDIS_URL=redis://:dev_only_change_me@127.0.0.1:6379/0
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Python worker (workers/) ---
# Worker dùng chung REDIS_URL ở trên (không có WORKER_REDIS_URL riêng).
WORKER_LOG_LEVEL=info

# --- Web (web/) --- biến NEXT_PUBLIC_* lọt vào bundle trình duyệt: không đặt secret ở đây.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
